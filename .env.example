# Supabase (required for products, orders, leads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (required for order confirmation and contact notifications)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Optional: where to send contact form notifications
RESEND_ADMIN_EMAIL=contato@yourdomain.com

# Site URL (required for Stripe success/cancel redirects and emails)
NEXT_PUBLIC_URL=http://localhost:3000

# Stripe (optional – only if you use Stripe checkout per product)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Sanity (optional – for admin studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
