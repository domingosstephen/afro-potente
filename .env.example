# Supabase (required for products, orders, leads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (required for order confirmation and contact notifications)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Optional: where to send contact form notifications
RESEND_ADMIN_EMAIL=contato@yourdomain.com

# Site URL (for emails and any redirect URLs)
NEXT_PUBLIC_URL=http://localhost:3000

# Sanity (optional – for admin studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Admin panel (/admin) – protects all /api/admin/* routes
# Set to any long random string. Keep it secret.
ADMIN_SECRET=your-random-admin-secret-key

# Kiwify API – enables auto-sync of checkout links from Kiwify → Supabase
# Get these from: Kiwify Dashboard > Apps > API > Criar API Key
KIWIFY_CLIENT_ID=your-kiwify-client-id
KIWIFY_CLIENT_SECRET=your-kiwify-client-secret
# Account ID shown on the same page as the API Key
KIWIFY_ACCOUNT_ID=your-kiwify-account-id
